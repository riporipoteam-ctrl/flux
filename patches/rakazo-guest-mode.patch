diff --git a/apps/web/src/lib/guest-rpc.ts b/apps/web/src/lib/guest-rpc.ts
new file mode 100644
index 0000000..054c76a
--- /dev/null
+++ b/apps/web/src/lib/guest-rpc.ts
@@ -0,0 +1,376 @@
+import type {
+  AppBootstrap,
+  AppContract,
+  Bot,
+  ComputerStatus,
+  Me,
+  ProductEvent,
+  Routine,
+  ThreadMessage,
+  ThreadSnapshot,
+} from "@rakazo/contracts";
+import { BOT_COLORS } from "@rakazo/contracts";
+import type { ContractRouterClient } from "@orpc/contract";
+
+type GuestState = {
+  bots: Bot[];
+  archivedBots: Bot[];
+  messages: Record<string, ThreadMessage[]>;
+  routines: Record<string, Routine[]>;
+  memories: Record<string, { id: string; scope: "bot" | "user"; botId: string | null; path: string; content: string; revision: number; updatedAt: string }[]>;
+  artifacts: Record<string, { id: string; botId: string; runId: string | null; name: string; mimeType: string; size: number; createdAt: string; contentBase64?: string }[]>;
+};
+
+const STORAGE_KEY = "rakazo-guest-workspace-v1";
+const GUEST_USER_ID = "guest-user";
+const GUEST_WORKSPACE_ID = "guest-workspace";
+const GUEST_BOT_ID = "guest-bot-askai";
+const GUEST_EMAIL = "guest@local.rakazo";
+let fluxAuthToken: string | null = null;
+let fluxAskAIEndpoint: string | null = null;
+if (typeof window !== "undefined") {
+  window.addEventListener("message", (event) => {
+    if (event.origin !== window.location.origin) return;
+    const data = event.data as { source?: string; type?: string; token?: unknown; endpoint?: unknown } | null;
+    if (data?.source !== "flux" || data.type !== "rakazo-auth") return;
+    fluxAuthToken = typeof data.token === "string" ? data.token : null;
+    fluxAskAIEndpoint = typeof data.endpoint === "string" ? data.endpoint : null;
+  });
+}
+const now = () => new Date().toISOString();
+const id = (prefix: string) => `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
+
+function computer(botId: string, state: ComputerStatus["state"] = "error"): ComputerStatus {
+  return {
+    botId,
+    mode: "team",
+    kind: "fake",
+    state,
+    controlHolder: "none",
+    controlBotId: null,
+    screenAvailable: false,
+    homeRevision: null,
+    busyBotName: null,
+  };
+}
+
+function starterBot(): Bot {
+  const createdAt = now();
+  return {
+    id: GUEST_BOT_ID,
+    workspaceId: GUEST_WORKSPACE_ID,
+    name: "AskAI",
+    title: "Your Rakazo guest teammate",
+    description: "A local guest teammate ready to help with ideas, planning, writing, and code.",
+    instructions: "Be useful, accurate, direct, and friendly. Explain your reasoning clearly.",
+    color: BOT_COLORS[3] ?? "#9B5CF6",
+    notifyOnFinish: true,
+    pinned: true,
+    archivedAt: null,
+    unread: false,
+    parentBotId: null,
+    threadId: "guest-thread-askai",
+    preview: "Ask me anything — no account required.",
+    status: "idle",
+    computerMode: "team",
+    updatedAt: createdAt,
+    createdAt,
+  };
+}
+
+function initialState(): GuestState {
+  return {
+    bots: [starterBot()],
+    archivedBots: [],
+    messages: {},
+    routines: {},
+    memories: {},
+    artifacts: {},
+  };
+}
+
+function loadState(): GuestState {
+  if (typeof window === "undefined") return initialState();
+  try {
+    const parsed = JSON.parse(window.localStorage.getItem(STORAGE_KEY) || "null") as Partial<GuestState> | null;
+    if (parsed?.bots?.length) return { ...initialState(), ...parsed } as GuestState;
+  } catch {
+    // A damaged guest store should recover to a clean Rakazo workspace.
+  }
+  return initialState();
+}
+
+const state = loadState();
+
+function persist() {
+  if (typeof window === "undefined") return;
+  window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+  window.dispatchEvent(new CustomEvent("rakazo-guest-updated"));
+}
+
+function getBot(botId: string): Bot {
+  const match = state.bots.find((bot) => bot.id === botId) ?? state.archivedBots.find((bot) => bot.id === botId);
+  if (match) return match;
+  const fallback = starterBot();
+  state.bots = [fallback, ...state.bots];
+  return fallback;
+}
+
+function getMessages(botId: string): ThreadMessage[] {
+  return state.messages[botId] ?? [];
+}
+
+function message(botId: string, role: ThreadMessage["role"], text: string): ThreadMessage {
+  const bot = getBot(botId);
+  const messages = getMessages(botId);
+  return {
+    id: id("message"),
+    threadId: bot.threadId,
+    seq: messages.length,
+    role,
+    blocks: [{ kind: "text", text }],
+    createdAt: now(),
+  };
+}
+
+function snapshot(botId: string): ThreadSnapshot {
+  const bot = getBot(botId);
+  const messages = getMessages(botId);
+  return {
+    botId: bot.id,
+    threadId: bot.threadId,
+    cursor: messages.length - 1,
+    messages,
+    olderCursor: null,
+    run: null,
+    computer: computer(bot.id),
+  };
+}
+
+function me(): Me {
+  return {
+    userId: GUEST_USER_ID,
+    email: GUEST_EMAIL,
+    name: "Guest",
+    workspaceId: GUEST_WORKSPACE_ID,
+    isDeploymentOwner: false,
+    needsModel: false,
+    defaultProvider: null,
+    defaultModel: null,
+    computerHost: null,
+    canChooseHostComputer: false,
+  };
+}
+
+function answer(text: string, bot: Bot): string {
+  const prompt = text.trim();
+  const lower = prompt.toLowerCase();
+  if (lower.includes("what can you do") || lower.includes("how does this work")) {
+    return `I’m ${bot.name}, running inside Rakazo guest mode. I can plan projects, write drafts, explain code, turn ideas into checklists, and organize routines. Your guest threads stay saved locally on this device. When Flux AI is available, I’ll use it automatically.`;
+  }
+  if (lower.includes("hello") || lower.includes("hi ") || lower === "hi") {
+    return "Hello! I’m ready. Ask me to plan, write, debug, compare, summarize, or turn a goal into steps.";
+  }
+  const arithmetic = lower.match(/(?:what is|calculate|solve)\s+(-?\d+(?:\.\d+)?)\s*([+\-*\/])\s*(-?\d+(?:\.\d+)?)/i)
+    || lower.match(/(-?\d+(?:\.\d+)?)\s*([+\-*\/])\s*(-?\d+(?:\.\d+)?)/i);
+  if (arithmetic) {
+    const left = Number(arithmetic[1]);
+    const operator = arithmetic[2].trim();
+    const right = Number(arithmetic[3]);
+    const result = operator === "+" ? left + right : operator === "-" ? left - right : operator === "*" ? left * right : right === 0 ? null : left / right;
+    return result === null ? "That division is undefined because the divisor is zero." : String(left) + " " + operator + " " + String(right) + " = " + String(result) + ".";
+  }
+  if (/(computer|desktop|mouse|click|screen|browser automation)/i.test(prompt)) {
+    return "This public guest build has no remote desktop host attached, so I won’t pretend I clicked or opened anything. I can still give you exact browser steps, write a checklist, or prepare the commands and files for a connected host.";
+  }
+  if (/(write|draft|caption|post|email|announcement)/i.test(prompt)) {
+    return "Here’s a clean first draft for \"" + prompt + "\":\n\nSubject: A clear next step\n\nHi — I’m sharing a concise update on this project. The goal is to make the experience easier to use, especially on smaller screens. I’ll validate the main path, collect feedback, and follow up with the next milestone.\n\nTell me the audience and tone and I’ll rewrite it.";
+  }
+  if (/(summarize|summary|tl;dr)/i.test(prompt)) {
+    return "I can summarize it into a one-line takeaway, key decisions, risks, and next actions. Paste the text or link you want summarized and tell me whether you prefer a brief or detailed version.";
+  }
+  if (/(compare|versus|\bvs\.?\b|trade-?off)/i.test(prompt)) {
+    return "Use this comparison frame for \"" + prompt + "\":\n\n- Best for speed: choose the option with fewer dependencies.\n- Best for control: choose the option you can inspect and change.\n- Best for reliability: choose the option with the clearest fallback.\n- Decision rule: pick the smallest option that meets the real constraint.\n\nGive me the two options and your constraint and I’ll make the trade-off explicit.";
+  }
+  if (/(plan|roadmap|steps|checklist|launch|build)/i.test(prompt)) {
+    return `Here’s a practical starting plan for “${prompt}”:\n\n1. Define the smallest outcome and who it is for.\n2. List the inputs, constraints, and what “done” means.\n3. Build one thin end-to-end version.\n4. Test the risky path on phone and desktop.\n5. Ship, measure, then iterate.\n\nTell me the deadline or constraint and I’ll turn this into a detailed checklist.`;
+  }
+  if (/(code|bug|error|debug|typescript|javascript|react|swift|sql)/i.test(prompt)) {
+    return `Let’s debug “${prompt}” methodically:\n\n- Reproduce it with the smallest input.\n- Capture the exact error and the first failing file/line.\n- Check state, network, and permissions before changing UI code.\n- Make one narrow fix, then test the original path plus a mobile path.\n\nPaste the error or the relevant file and I’ll propose the smallest safe patch.`;
+  }
+  return `Guest mode is ready. I received: “${prompt}”\n\nI can work through that with you here. Give me context, constraints, or the result you want and I’ll turn it into a useful next step.`;
+}
+
+function messageText(item: ThreadMessage): string {
+  return item.blocks
+    .map((block) => {
+      const value = block as { text?: unknown };
+      return typeof value.text === "string" ? value.text : "";
+    })
+    .filter(Boolean)
+    .join("\n");
+}
+
+async function remoteAnswer(botId: string, prompt: string): Promise<string | null> {
+  if (!fluxAuthToken || !fluxAskAIEndpoint) return null;
+  const messages = [
+    ...getMessages(botId).slice(-15).map((item) => ({
+      role: item.role === "bot" ? "assistant" as const : "user" as const,
+      content: messageText(item),
+    })),
+    { role: "user" as const, content: prompt },
+  ].filter((item) => item.content);
+  try {
+    const response = await fetch(fluxAskAIEndpoint, {
+      method: "POST",
+      headers: { Authorization: `Bearer ${fluxAuthToken}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ mode: "instant", messages, workspaceContext: "Rakazo official open-source guest workspace inside Flux. Do not claim computer actions unless tool output proves them." }),
+    });
+    const data = await response.json().catch(() => ({})) as { answer?: unknown };
+    return response.ok && typeof data.answer === "string" && data.answer.trim() ? data.answer.trim() : null;
+  } catch {
+    return null;
+  }
+}
+
+function addMessage(botId: string, role: ThreadMessage["role"], text: string) {
+  state.messages[botId] = [...getMessages(botId), message(botId, role, text)].slice(-200);
+  const bot = getBot(botId);
+  bot.preview = text.slice(0, 100);
+  bot.updatedAt = now();
+  persist();
+}
+
+function routine(botId: string, input: Record<string, unknown>): Routine {
+  const createdAt = now();
+  return {
+    id: id("routine"),
+    botId,
+    name: String(input.name ?? "New routine"),
+    prompt: String(input.prompt ?? ""),
+    cron: String(input.cron ?? ""),
+    timezone: String(input.timezone ?? "UTC"),
+    active: Boolean(input.active),
+    notify: input.notify !== false,
+    lastRunAt: null,
+    nextRunAt: null,
+    createdAt,
+  };
+}
+
+async function* subscribe(_input: unknown, options?: { signal?: AbortSignal }): AsyncGenerator<ProductEvent> {
