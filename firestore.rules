rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == "ripo.ripoteam@gmail.com";
    }

    function isOwner() {
      return isAdmin();
    }

    function follows(fromUid, toUid) {
      return exists(/databases/$(database)/documents/users/$(fromUid)/following/$(toUid));
    }

    function mutualFriends(uidA, uidB) {
      return signedIn() && follows(uidA, uidB) && follows(uidB, uidA);
    }

    function isBusiness(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.accountType == "business";
    }

    function conversationParticipant(convId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
    }

    function callParticipant(callId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds;
    }

    function isLiveHost(streamId) {
      return signedIn()
        && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid)
        && request.resource.data.email == request.auth.token.email
        && (isOwner() || (
          request.resource.data.isAdmin != true
          && request.resource.data.isOwner != true
        ));
      allow update: if (
          isSelf(uid)
          && request.resource.data.email == request.auth.token.email
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'isOwner', 'email'])
        )
        || isOwner()
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isVerified', 'verifiedType', 'coins', 'isAdmin', 'updatedAt']));
      allow delete: if isAdmin();

      match /following/{targetId} {
        allow read: if true;
        allow write: if isSelf(uid);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == followerId;
        allow update: if false;
      }

      match /likes/{postId} {
        allow read, write: if isSelf(uid);
      }

      match /bookmarks/{postId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /posts/{postId} {
      allow read: if resource.data.isDeleted != true
        && (
          !('visibility' in resource.data)
          || resource.data.visibility == null
          || resource.data.visibility == "public"
          || (signedIn() && resource.data.authorId == request.auth.uid)
          || isAdmin()
        )
        && (
          resource.data.isDraft != true
          || (signedIn() && resource.data.authorId == request.auth.uid)
        );
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.isAdmin != true;
      allow update, delete: if signedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if true;
        allow write: if isSelf(uid);
      }

      match /reposts/{uid} {
        allow read: if true;
        allow write: if isSelf(uid);
      }

      match /bookmarks/{uid} {
        allow read, write: if isSelf(uid);
      }

      match /pollVotes/{uid} {
        allow read: if true;
        allow create: if isSelf(uid);
        allow update, delete: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.expiresAt > request.time
        && request.resource.data.text.size() <= 240;
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
      );
      allow delete: if signedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      match /views/{uid} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow create, update: if isSelf(uid);
        allow delete: if false;
      }
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /hashtags/{tag} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    match /blocks/{id} {
      allow read: if signedIn();
      allow create, delete: if signedIn()
        && request.resource.data.blockerId == request.auth.uid;
    }

    match /mutes/{id} {
      allow read: if signedIn() && resource.data.muterId == request.auth.uid;
      allow write: if signedIn();
    }

    match /lists/{listId} {
      allow read: if resource.data.isPrivate != true
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    match /groups/{groupId} {
      allow read: if resource.data.isPrivate != true || signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /members/{uid} {
        allow read: if true;
        allow write: if signedIn();
      }

      match /ranks/{rankId} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    match /conversations/{convId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 50
        && (
          request.resource.data.type == "group"
          || (
            request.resource.data.type == "dm"
            && request.resource.data.participantIds.size() == 2
          )
        );
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt'])
          || (
            resource.data.type == "group"
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'avatarUrl', 'participantIds', 'updatedAt'])
          )
        );
      allow delete: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (resource.data.type == "dm" && request.auth.uid in resource.data.participantIds)
          || isAdmin()
        );

      match /messages/{messageId} {
        allow read: if conversationParticipant(convId);
        allow create: if conversationParticipant(convId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text.size() <= 10000;
        allow update: if conversationParticipant(convId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'readBy']);
        allow delete: if conversationParticipant(convId)
          && resource.data.senderId == request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if conversationParticipant(convId);
        allow write: if conversationParticipant(convId) && isSelf(uid);
      }
    }

    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.callerId in request.resource.data.participantIds
        && request.resource.data.calleeId in request.resource.data.participantIds
        && mutualFriends(request.resource.data.callerId, request.resource.data.calleeId)
        && !isBusiness(request.resource.data.callerId)
        && !isBusiness(request.resource.data.calleeId);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if signedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());

      match /callerCandidates/{candidateId} {
        allow read, create: if callParticipant(callId);
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read, create: if callParticipant(callId);
        allow update, delete: if false;
      }
    }

    match /liveStreams/{streamId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.hostId == request.auth.uid
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
      );
      allow delete: if signedIn()
        && (resource.data.hostId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text.size() <= 300;
        allow update, delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || isLiveHost(streamId) || isAdmin());
      }

      match /viewers/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isSelf(uid);
      }

      match /peers/{viewerId} {
        allow read: if signedIn();
        allow create: if isSelf(viewerId);
        allow update: if signedIn() && (isSelf(viewerId) || isLiveHost(streamId));
        allow delete: if signedIn() && (isSelf(viewerId) || isLiveHost(streamId) || isAdmin());

        match /hostCandidates/{candidateId} {
          allow read: if signedIn();
          allow create: if isLiveHost(streamId);
          allow update, delete: if false;
        }

        match /viewerCandidates/{candidateId} {
          allow read: if signedIn();
          allow create: if isSelf(viewerId);
          allow update, delete: if false;
        }
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && (resource.data.hostId == request.auth.uid || isAdmin());

      match /attendees/{uid} {
        allow read: if true;
        allow write: if isSelf(uid);
      }
    }

    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /purchases/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /gifts/{id} {
      allow read: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromId == request.auth.uid;
    }

    match /coinTransactions/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
    }

    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userChallenges/{id} {
      allow read, write: if signedIn();
    }

    match /aiConversations/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, create, update, delete: if signedIn()
          && get(/databases/$(database)/documents/aiConversations/$(id)).data.userId == request.auth.uid;
      }
    }

    match /activity/{uid}/events/{eventId} {
      allow read, write: if isSelf(uid);
    }

    match /adminLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /adminMessages/{id} {
      allow create: if isAdmin();
      allow read, update: if signedIn()
        && (resource.data.toUserId == request.auth.uid || isAdmin());
    }

    match /customBadges/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shopMeta/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /accountLinks/{linkId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn();
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids;

      match /publicMembers/{uid} {
        allow read, write: if signedIn();
      }
    }

    match /streamHosts/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /publishedRooms/{roomId} {
      allow read: if resource.data.get('isPrivate', false) != true
        || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.isOfficial != true
        && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn()
        && (
          resource.data.authorId == request.auth.uid
          || (
            resource.data.get('isPrivate', false) != true
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['visits', 'cheers', 'updatedAt'])
          )
        );
      allow delete: if isOwner()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /gameConfig/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /gameAnnouncements/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /gameSessions/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /hangoutRooms/{roomCode} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();

      match /players/{uid} {
        allow read: if signedIn();
        allow create, delete: if isSelf(uid);
        allow update: if signedIn();
      }

      match /chat/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn()
          && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /pickups/{pickupId} {
        allow read, write: if signedIn();
      }
    }

    match /fluxFarmSaves/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0
        && request.resource.data.day is number
        && request.resource.data.day >= 1;
      allow delete: if isSelf(uid) || isAdmin();
    }
  }
}
