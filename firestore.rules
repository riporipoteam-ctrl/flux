rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open rules: any signed-in user can read/write everything.
    // (Armin's explicit request 2026-09-24: stop the "Missing or insufficient permissions" errors.)

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == "ripo.ripoteam@gmail.com";
    }

    function isOwner() {
      return isAdmin();
    }

    // ---- Social collections: fully open to signed-in users ----
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isOwner'])
        || isAdmin();
      allow delete: if isAdmin();

      match /following/{targetId} {
        allow read: if true;
        allow write: if signedIn();
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if signedIn();
      }

      match /likes/{postId} {
        allow read, write: if signedIn();
      }

      match /bookmarks/{postId} {
        allow read, write: if signedIn();
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn();

      match /likes/{uid} {
        allow read: if true;
        allow write: if signedIn();
      }

      match /reposts/{uid} {
        allow read: if true;
        allow write: if signedIn();
      }

      match /bookmarks/{uid} {
        allow read, write: if signedIn();
      }

      match /pollVotes/{uid} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /views/{uid} {
        allow read, write: if signedIn();
      }
    }

    match /notifications/{id} {
      allow read, write: if signedIn();
    }

    match /hashtags/{tag} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /reports/{id} {
      allow read, write: if signedIn();
    }

    match /blocks/{id} {
      allow read, write: if signedIn();
    }

    match /mutes/{id} {
      allow read, write: if signedIn();
    }

    match /lists/{listId} {
      allow read: if true;
      allow write: if signedIn();

      match /members/{uid} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    match /groups/{groupId} {
      allow read: if true;
      allow write: if signedIn();

      match /members/{uid} {
        allow read: if true;
        allow write: if signedIn();
      }

      match /ranks/{rankId} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    match /conversations/{convId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }

      match /typing/{uid} {
        allow read, write: if signedIn();
      }
    }

    match /calls/{callId} {
      allow read, write: if signedIn();

      match /callerCandidates/{candidateId} {
        allow read, write: if signedIn();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if signedIn();
      }
    }

    match /liveStreams/{streamId} {
      allow read: if true;
      allow write: if signedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow write: if signedIn();
      }

      match /viewers/{uid} {
        allow read, write: if signedIn();
      }

      match /peers/{viewerId} {
        allow read, write: if signedIn();

        match /hostCandidates/{candidateId} {
          allow read, write: if signedIn();
        }

        match /viewerCandidates/{candidateId} {
          allow read, write: if signedIn();
        }
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if signedIn();

      match /attendees/{uid} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /purchases/{id} {
      allow read, write: if signedIn();
    }

    match /gifts/{id} {
      allow read, write: if signedIn();
    }

    match /coinTransactions/{id} {
      allow read, write: if signedIn();
    }

    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /userChallenges/{id} {
      allow read, write: if signedIn();
    }

    match /aiConversations/{id} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    match /askAIWorkspaces/{uid} {
      allow read, write: if signedIn();
    }

    match /activity/{uid}/events/{eventId} {
      allow read, write: if signedIn();
    }

    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow write: if signedIn();
    }

    match /adminMessages/{id} {
      allow read, write: if signedIn();
    }

    match /customBadges/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /shopMeta/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /accountLinks/{linkId} {
      allow read, write: if signedIn();

      match /publicMembers/{uid} {
        allow read, write: if signedIn();
      }
    }

    match /streamHosts/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /publishedRooms/{roomId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /gameConfig/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /gameAnnouncements/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /gameSessions/{uid} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /hangoutRooms/{roomCode} {
      allow read, write: if signedIn();

      match /players/{uid} {
        allow read, write: if signedIn();
      }

      match /chat/{messageId} {
        allow read, write: if signedIn();
      }

      match /pickups/{pickupId} {
        allow read, write: if signedIn();
      }
    }

    match /fluxFarmSaves/{uid} {
      allow read: if true;
      allow write: if signedIn();
    }

    // ---- Legacy game collections ----
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /players/{uid}/saves/{saveId} {
      allow read, write: if request.auth != null;
    }

    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /meta/manifest {
      allow read: if true;
      allow write: if false;
    }
  }
}
